{
  "name": "no-money-down",
  "productName": "NO MONEY DOWN",
  "version": "0.6.0",
  "description": "NO MONEY DOWN — a first-person co-op friendslop road trip. One RV, one shared bank account, one Repo Man.",
  "author": "The NO MONEY DOWN developers",
  "type": "module",
  "main": "desktop/main.cjs",
  "steamAppId": 480,
  "scripts": {
    "start": "node server/index.js",
    "dev": "node server/index.js --port 3000",
    "desktop": "electron .",
    "test": "node tools/namecheck.mjs && node test/logic.mjs && node test/server.mjs && node test/finds.mjs && node test/mobs.mjs && node test/rv.mjs && node test/fences.mjs && node test/movement.mjs && node test/steamnet.mjs && node test/music.mjs && node test/tracks.mjs && node test/shop.mjs && node test/dig.mjs && node test/looks.mjs && node test/dynamite.mjs && node test/snow.mjs && node test/smoke-browser.mjs",
    "test:logic": "node test/logic.mjs",
    "test:names": "node tools/namecheck.mjs",
    "test:server": "node test/server.mjs",
    "test:mobs": "node test/mobs.mjs",
    "test:finds": "node test/finds.mjs",
    "test:rv": "node test/rv.mjs",
    "test:fences": "node test/fences.mjs",
    "test:music": "node test/music.mjs",
    "test:tracks": "node test/tracks.mjs",
    "test:shop": "node test/shop.mjs",
    "test:dig": "node test/dig.mjs",
    "test:looks": "node test/looks.mjs",
    "test:dynamite": "node test/dynamite.mjs",
    "test:snow": "node test/snow.mjs",
    "test:movement": "node test/movement.mjs",
    "test:steam": "node test/steamnet.mjs",
    "test:desktop": "node test/desktop-smoke.mjs",
    "test:race": "node tools/joinrace.mjs && node tools/dayrace.mjs",
    "icons": "node desktop/make-icons.mjs",
    "dist:win": "electron-builder --config desktop/electron-builder.cjs --win",
    "dist:linux": "electron-builder --config desktop/electron-builder.cjs --linux",
    "dist": "electron-builder --config desktop/electron-builder.cjs --win --linux"
  },
  "dependencies": {
    "@dimforge/rapier3d-compat": "^0.21.0",
    "koffi": "2.16.3",
    "steamworks.js": "0.4.0",
    "ws": "^8.18.0"
  },
  "devDependencies": {
    "electron": "44.7.0",
    "electron-builder": "26.15.3",
    "playwright-core": "1.64.0",
    "three": "^0.185.1"
  },
  "engines": {
    "node": ">=20"
  }
}
